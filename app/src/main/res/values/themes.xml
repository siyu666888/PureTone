<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用基础主题（Compose 接管实际配色，此处仅提供启动外壳）。
         平台无 Theme.Material.DayNight，故用 Light 父主题 + values-night 深色覆盖。 -->
    <style name="Theme.PureTone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- windowLayoutInDisplayCutoutMode 需 API 27，见 values-v27/themes.xml -->
    </style>

    <!-- 启动屏主题 -->
    <style name="Theme.PureTone.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.PureTone</item>
    </style>

</resources>
