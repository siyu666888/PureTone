<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务播放 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 通知（播放控制） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 音频焦点保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 联网匹配歌曲元数据 / 封面（Item 5） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DLNA 投屏：取本机局域网 IP / 监听 SSDP 组播（UPnPCast 库自身也声明了，
         此处显式声明确保合并后一定存在） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 投屏设备发现（问题1 修复）：Android 13+ 用 NEARBY_WIFI_DEVICES 且不取定位；
         Android 12 及以下 SSDP/mDNS 扫描硬性要求 ACCESS_FINE_LOCATION，否则在
         targetSdk≥29 上 DLNACast.search() 会静默返回空列表 → UI 显示「未发现可投屏设备」。 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- lint 的 CoarseFineLocation 规则要求：声明 FINE 必须同时声明 COARSE（仅需配对，运行时仍只申请 FINE） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- 媒体库读取（API 33+ 细化权限；低版本向下兼容） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- P2-15：本地播放器没有账号/令牌，但 Room 库里是完整的播放历史与歌单，
         DataStore 里是听歌偏好。默认 allowBackup=true 会让这些数据被 adb 备份或
         云备份整体抽走；这里按「隐私最小化」关闭（用户数据随 App 卸载清理即可）。
         P2-5：Android 12L（API 31）起 allowBackup 的语义已被 dataExtractionRules
         部分取代——它对「云备份」与「设备到设备迁移」分别生效，且设备迁移
         不受 allowBackup 约束。故补两份规则文件把两条路径都显式排除：
         API 31+ 读 data_extraction_rules.xml，API ≤ 30 读 backup_rules.xml。 -->
    <!-- P0-4 明文流量审计：公网请求（iTunes Search / LRCLIB）均走 HTTPS，零明文；
         唯一的明文是 DLNA 投屏——向局域网渲染设备的 LAN IP 发 SOAP 控制指令。
         NSC 的 domain-config 只认主机名、不支持 CIDR 网段，无法写成「仅局域网放行」，
         故 base-config 保留明文能力，但改用显式 NSC 声明 + 审计说明，
         把原来的隐性默认变成可审计的明确决策（行为与原 usesCleartextTraffic 等价）。 -->
    <application
        android:name=".PureToneApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureTone"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.PureTone.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- P3-1 诊断导出：共享 cacheDir/diagnostics 下的诊断报告文件（见 DiagnosticExport）。
             不导出、不赋予文件级读权限，仅通过 FLAG_GRANT_READ_URI_PERMISSION 给分享目标临时读。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小部件：Exported 是 AppWidgetProvider 的硬性要求（桌面要给到 receiver）；
             更新推送走 App 内的 GlanceAppWidget.update，不依赖系统周期轮询。 -->
        <receiver
            android:name=".widget.PureToneWidgetReceiver"
            android:exported="true"
            android:label="@string/app_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/puretone_widget_info" />
        </receiver>
    </application>

</manifest>
