<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务播放 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 通知（播放控制） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 音频焦点保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 联网匹配歌曲元数据 / 封面（Item 5） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DLNA 投屏：取本机局域网 IP / 监听 SSDP 组播（UPnPCast 库自身也声明了，
         此处显式声明确保合并后一定存在） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 媒体库读取（API 33+ 细化权限；低版本向下兼容） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- P2-15：本地播放器没有账号/令牌，但 Room 库里是完整的播放历史与歌单，
         DataStore 里是听歌偏好。默认 allowBackup=true 会让这些数据被 adb 备份或
         云备份整体抽走；这里按「隐私最小化」关闭（用户数据随 App 卸载清理即可）。 -->
    <!-- P0-4 明文流量审计：公网请求（iTunes Search / LRCLIB）均走 HTTPS，零明文；
         唯一的明文是 DLNA 投屏——向局域网渲染设备的 LAN IP 发 SOAP 控制指令。
         NSC 的 domain-config 只认主机名、不支持 CIDR 网段，无法写成「仅局域网放行」，
         故 base-config 保留明文能力，但改用显式 NSC 声明 + 审计说明，
         把原来的隐性默认变成可审计的明确决策（行为与原 usesCleartextTraffic 等价）。 -->
    <application
        android:name=".PureToneApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureTone"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.PureTone.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 桌面小部件：Exported 是 AppWidgetProvider 的硬性要求（桌面要给到 receiver）；
             更新推送走 App 内的 GlanceAppWidget.update，不依赖系统周期轮询。 -->
        <receiver
            android:name=".widget.PureToneWidgetReceiver"
            android:exported="true"
            android:label="@string/app_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/puretone_widget_info" />
        </receiver>
    </application>

</manifest>
